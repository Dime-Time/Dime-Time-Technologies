{
  "appId": "com.dimetime.mobile",
  "appName": "Dime Time",
  "webDir": "dist/public",
  "server": {
    "url": "https://ceb23eaa-0ec0-4109-a10a-5e37190a0ad7-00-1yqkfaf9bsv5w.worf.replit.dev",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#918EF4",
      "showSpinner": true,
      "iosSpinnerStyle": "small",
      "spinnerColor": "#ffffff"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#918EF4"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "App": {
      "statusBarStyle": "dark-content"
    },
    "Haptics": {},
    "LocalNotifications": {
      "iconColor": "#918EF4"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}